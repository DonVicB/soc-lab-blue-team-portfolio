# SOC Lab Blue Team Portfolio — local-only and sensitive files
#
# IMPORTANT:
# .gitignore only prevents NEW, untracked matching files from being added
# with ordinary Git staging. It does not remove files already committed
# or prevent deliberate force-adds. Always review: git status / git diff --cached
# Never commit real credentials, even to a private repository.

# === Credentials, secrets and local environment ===
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.keyx
*.keyfile
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*
.ssh/
.aws/
.azure/
.gcloud/
.kube/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
.terraform/
terraform.tfstate.d/
secrets.yml
secrets.yaml
secrets.json
secrets.env
credentials.json
credentials.yml
credentials.yaml
credentials.ini
credentials.xml
token.txt
tokens.txt
*.token

# === Security tooling credentials / local state ===
client.keys
splunk.secret
passwords.conf
authentication.conf
wazuh-passwords*.txt
ossec.conf
